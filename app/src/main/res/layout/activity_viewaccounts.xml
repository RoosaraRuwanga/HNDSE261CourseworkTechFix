<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    tools:context=".activities.ViewAccountsActivity">

    <TextView
        android:id="@+id/txt_tagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search For Accounts"
        android:textAlignment="textStart"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/txt_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_tagline"
        android:layout_marginTop="30dp"
        android:hint="Enter account name"
        android:textAlignment="center" />

    <Button
        android:id="@+id/btn_viewaccounts"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_search"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="View Accounts"
        android:textSize="25sp" />

    <ScrollView
        android:id="@+id/scroll_accounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/btn_viewaccounts"
        android:layout_above="@+id/btn_back"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:id="@+id/accounts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/btn_back"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:text="Back"
        android:textSize="25sp" />

</RelativeLayout>