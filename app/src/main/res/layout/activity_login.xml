<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    tools:context=".activities.LoginActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="40dp"
        android:textAlignment="center"
        android:text="[TECHFIX]"
        android:id="@+id/txt_logo"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15dp"
        android:textAlignment="center"
        android:text="Best Mobile Repair Service in Sri Lanka!"
        android:layout_below="@id/txt_logo"
        android:id="@+id/txt_tagline"
        />

    <TextView
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20dp"
        android:text="Login"
        android:layout_below="@id/txt_tagline"
        android:id="@+id/txt_login"
        />
    <!-- Using email because some people can have the same username-->
    <TextView
        android:layout_marginTop="50dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20dp"
        android:text="Email"
        android:layout_below="@id/txt_login"
        android:id="@+id/txt_email"
        />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text=""
        android:layout_below="@id/txt_email"
        android:id="@+id/edit_email"
        />
    <TextView
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20dp"
        android:text="Password"
        android:layout_below="@id/edit_email"
        android:id="@+id/txt_login_password"
        />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text=""
        android:layout_below="@id/txt_login_password"
        android:id="@+id/edit_password"
        />

    <Button
        android:layout_marginTop="40dp"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textSize="25dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/edit_password"
        android:id="@+id/btn_login"/>

    <TextView
        android:layout_marginTop="90dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20dp"
        android:text="Don't have an account?"
        android:layout_below="@id/btn_login"
        android:id="@+id/txt_register"
        />
    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Register"
        android:textSize="25dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/txt_register"
        android:id="@+id/btn_register"/>
</RelativeLayout>