<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".activities.CustomerDashboardActivity">

    <!-- TECHFIX -->
    <TextView
        android:id="@+id/tvTechFix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="TechFix"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- CUSTOMER NAME -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTechFix"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Welcome!"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- BRANCH INFORMATION -->
    <Button
        android:id="@+id/btnBranchInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWelcome"
        android:layout_marginTop="25dp"
        android:text="View Branch Information" />

    <!-- SERVICES -->
    <Button
        android:id="@+id/btnServices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnBranchInfo"
        android:layout_marginTop="12dp"
        android:text="Search Available Services" />

    <!-- REPAIR HISTORY -->
    <Button
        android:id="@+id/btnRepairHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnServices"
        android:layout_marginTop="12dp"
        android:text="Repair Status &amp; History" />

    <!-- LOGOUT -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:text="Logout" />

</RelativeLayout>