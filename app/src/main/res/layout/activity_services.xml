<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".activities.ServicesActivity">

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvServicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Available Services"
        android:textSize="18sp"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- SERVICE DROPDOWN -->
    <Spinner
        android:id="@+id/spinnerServices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvServicesTitle"
        android:layout_marginTop="20dp" />

    <!-- SERVICE IMAGE -->
    <ImageView
        android:id="@+id/imgService"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_below="@id/spinnerServices"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:contentDescription="Service Image"
        android:scaleType="centerCrop" />

    <!-- SERVICE TITLE -->
    <TextView
        android:id="@+id/tvServiceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgService"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Service Title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- DESCRIPTION BOX -->
    <TextView
        android:id="@+id/tvServiceDescription"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_below="@id/tvServiceTitle"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Description"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- BRANCH LABEL -->
    <TextView
        android:id="@+id/tvBranchLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvServiceDescription"
        android:layout_marginTop="10dp"
        android:text="Branch"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- CLOSEST BRANCH -->
    <Spinner
        android:id="@+id/spinnerBranch"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/tvBranchLabel"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/tvBranchLabel"
        android:layout_marginStart="15dp" />

    <!-- REQUEST SERVICE -->
    <Button
        android:id="@+id/btnRequestService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvBranchLabel"
        android:layout_marginTop="20dp"
        android:text="Request Service" />

    <!-- BACK -->
    <Button
        android:id="@+id/btnServicesBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnRequestService"
        android:layout_marginTop="10dp"
        android:text="Back" />

</RelativeLayout>